---
// Restoration/roofing service template (spec §3):
// hero → "do this now" steps → process → why speed matters → insurance → reviews → photos → FAQ → CTA
import Base from './Base.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import { reviewsFor } from '../data/reviews';

interface Props {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  heroTitle: string;
  heroText: string;
  urgentHeading: string;
  urgentSteps: string[];
  processSteps: { title: string; text: string }[];
  whySpeed: string;
  faqs: { q: string; a: string }[];
  heroImage?: string;
  /* Real job photos. Section is omitted entirely when there are none — an empty
     placeholder grid on a live site reads worse than no gallery. A caption turns
     a photo set into a job story, which is what actually sells restoration work. */
  gallery?: { src: string; alt: string; caption?: string }[];
  galleryHeading?: string;
  galleryIntro?: string;
  /* SEO: short label for breadcrumbs, and Service schema copy */
  label: string;
  serviceDescription: string;
}

const {
  slug,
  metaTitle,
  metaDescription,
  heroTitle,
  heroText,
  urgentHeading,
  urgentSteps,
  processSteps,
  whySpeed,
  faqs,
  heroImage,
  gallery,
  galleryHeading,
  galleryIntro,
  label,
  serviceDescription,
} = Astro.props;

const heroStyle = heroImage
  ? `background: linear-gradient(rgba(12, 36, 64, 0.78), rgba(12, 36, 64, 0.78)), url('${heroImage}') center / cover no-repeat, var(--blue-dark);`
  : undefined;
---

<Base
  title={metaTitle}
  description={metaDescription}
  ogImage={gallery?.[0]?.src ?? heroImage}
  breadcrumb={label}
  service={{ name: label, description: serviceDescription }}
>
  <TrustBar />

  <section class="hero section" style={heroStyle}>
    <div class="container">
      <h1>{heroTitle}</h1>
      <p class="hero__text">{heroText}</p>
      <div class="hero__actions">
        <a href={site.phoneHref} class="btn btn--emergency">📞 Call Now — {site.phone}</a>
        <a href="/contact" class="btn btn--outline">Request Help Online</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>{urgentHeading}</h2>
      <ol class="steps">
        {urgentSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How We Handle It</h2>
      <ol class="steps">
        {processSteps.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <p style="margin: 0.25rem 0 0;">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Why Acting Fast Matters</h2>
      <p style="max-width: 46rem;">{whySpeed}</p>

      <h3 style="margin-top: 2rem;">We Handle It From Here</h3>
      {/*
        TONE: reassuring, never adversarial (owner direction) — the process is
        stressful and Coastal carries it.
        LEGAL LINE (spec §6): documenting damage, writing the scope, and walking the
        property with the adjuster are standard contractor work. Do NOT change this
        to say Coastal negotiates or settles claims: under Fla. Stat. 489.147 a
        contractor may not negotiate a claim, and advertising it is unlicensed
        public adjusting.
      */}
      <p style="max-width: 46rem;">
        The repairs are only part of what lands on you. There's the documentation,
        the adjuster's visit, working out the scope, scheduling the trades — all
        while you're trying to get life back to normal. We take that off your plate:
        every inch of the damage documented with photos and moisture readings, a
        detailed scope of what your home needs, and we're the ones walking the
        property with the adjuster. From the insurance claim to the final coat of
        paint, it's handled.
        <a href="/insurance-claim">See how it works →</a>
      </p>
    </div>
  </section>

  <ReviewsStrip items={reviewsFor(slug)} />

  {gallery && gallery.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{galleryHeading ?? 'Recent Work'}</h2>
        {galleryIntro && <p class="gallery-intro">{galleryIntro}</p>}
        <div class="grid grid--3">
          {gallery.map((g) => (
            <figure class="gallery-fig">
              <img src={g.src} alt={g.alt} class="gallery-img" loading="lazy" />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <FAQ items={faqs} />

  <CTABand />
</Base>

<style>
  .hero {
    background: linear-gradient(rgba(12, 36, 64, 0.85), rgba(12, 36, 64, 0.85)),
      var(--blue-dark);
    /* TODO: layer real service photo behind the gradient */
    color: #fff;
  }

  .hero__text {
    font-size: 1.15rem;
    max-width: 42rem;
    color: #d5e4ec;
  }

  .gallery-intro {
    max-width: 46rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .gallery-fig { margin: 0; }

  .gallery-img {
    width: 100%;
    height: 14rem;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .gallery-fig figcaption {
    font-size: 0.9rem;
    color: var(--muted);
    padding-top: 0.5rem;
    line-height: 1.45;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 24rem;
  }

  @media (min-width: 640px) {
    .hero__actions { flex-direction: row; max-width: none; }
  }
</style>
