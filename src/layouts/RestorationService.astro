---
// Restoration/roofing service template (spec §3):
// hero → "do this now" steps → process → why speed matters → insurance → reviews → photos → FAQ → CTA
import Base from './Base.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import { reviewsFor } from '../data/reviews';

interface Props {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  heroTitle: string;
  heroText: string;
  urgentHeading: string;
  urgentSteps: string[];
  processSteps: { title: string; text: string }[];
  whySpeed: string;
  faqs: { q: string; a: string }[];
  heroImage?: string;
}

const {
  slug,
  metaTitle,
  metaDescription,
  heroTitle,
  heroText,
  urgentHeading,
  urgentSteps,
  processSteps,
  whySpeed,
  faqs,
  heroImage,
} = Astro.props;

const heroStyle = heroImage
  ? `background: linear-gradient(rgba(12, 36, 64, 0.78), rgba(12, 36, 64, 0.78)), url('${heroImage}') center / cover no-repeat, var(--blue-dark);`
  : undefined;
---

<Base title={metaTitle} description={metaDescription}>
  <TrustBar />

  <section class="hero section" style={heroStyle}>
    <div class="container">
      <h1>{heroTitle}</h1>
      <p class="hero__text">{heroText}</p>
      <div class="hero__actions">
        <a href={site.phoneHref} class="btn btn--emergency">📞 Call Now — {site.phone}</a>
        <a href="/contact" class="btn btn--outline">Request Help Online</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>{urgentHeading}</h2>
      <ol class="steps">
        {urgentSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How We Handle It</h2>
      <ol class="steps">
        {processSteps.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <p style="margin: 0.25rem 0 0;">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Why Acting Fast Matters</h2>
      <p style="max-width: 46rem;">{whySpeed}</p>

      <h3 style="margin-top: 2rem;">You Shouldn't Have to Take This On Alone</h3>
      {/*
        LEGAL LINE (spec §6): describes documenting damage and working the repair
        scope with the adjuster — all standard contractor work. Do NOT change this
        to say Coastal negotiates or settles claims: under Fla. Stat. 489.147 a
        contractor may not negotiate a claim, and advertising it is unlicensed
        public adjusting.
      */}
      <p style="max-width: 46rem;">
        Insurance companies do this every single day. They have staff adjusters,
        engineers, and attorneys on their side of the table. Most homeowners are
        doing it for the first time, from a house that just got wrecked — and that
        gap is where people get shortchanged. That's where we come in. We document
        every inch of the damage with photos, moisture readings, and a detailed
        scope of work, and we handle the back-and-forth with the adjuster over what
        your repairs actually require, so you're not the one trying to argue it.
        <a href="/insurance-claim">See how the claim process works →</a>
      </p>
    </div>
  </section>

  <ReviewsStrip items={reviewsFor(slug)} />

  <section class="section">
    <div class="container">
      <h2>Recent Work</h2>
      <div class="grid grid--3">
        {/* TODO: replace with real before/after photos (public/images/README.md) */}
        <div class="img-placeholder">Before/after photo — real project</div>
        <div class="img-placeholder">Before/after photo — real project</div>
        <div class="img-placeholder">Before/after photo — real project</div>
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTABand />
</Base>

<style>
  .hero {
    background: linear-gradient(rgba(12, 36, 64, 0.85), rgba(12, 36, 64, 0.85)),
      var(--blue-dark);
    /* TODO: layer real service photo behind the gradient */
    color: #fff;
  }

  .hero__text {
    font-size: 1.15rem;
    max-width: 42rem;
    color: #d5e4ec;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 24rem;
  }

  @media (min-width: 640px) {
    .hero__actions { flex-direction: row; max-width: none; }
  }
</style>
