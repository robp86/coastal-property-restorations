---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// LocalBusiness schema on every page (spec §4).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: ['Punta Gorda FL', 'Port Charlotte FL', 'Fort Myers FL'],
  openingHours: 'Mo-Su 00:00-24:00', // TODO: confirm 24/7 (spec Q3)
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {/* TODO(launch-blocker): GA4 snippet + tel-click / form-submit events (spec §6) */}
    {/* TODO(launch-blocker): CallRail dynamic number insertion script (spec §6) */}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <StickyCallBar />
  </body>
</html>
