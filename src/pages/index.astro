---
// Homepage — anatomy per spec §2.
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import CTABand from '../components/CTABand.astro';
import { site, cities } from '../data/site';
import { services } from '../data/services';
import { reviews } from '../data/reviews';
---

<Base
  title="Coastal Property Restorations | Water Damage Restoration & Remodeling — Punta Gorda, FL"
  description={site.description}
>
  <Splash />
  <TrustBar />

  {/*
    Hero layout (owner request): photo on top with the two CTAs anchored to its
    bottom corners and the tagline centered between them; headline directly
    under the photo. On mobile the bar drops below the photo and stacks — three
    items side by side don't fit a phone width.
  */}
  <section class="hero">
    <div class="hero__stage">
      <div class="hero__media"></div>
      <div class="hero__barwrap">
        <div class="container hero__bar">
          <a href={site.phoneHref} class="btn btn--emergency hero__btn">
            🚨 Emergency? Call Now
          </a>
          <p class="hero__sub">
            Local, owner-operated restoration and remodeling across
            Southwest Florida — with 24/7 emergency response.
          </p>
          <a href="/contact" class="btn btn--primary hero__btn">
            🛠️ Planning a Renovation? Free Estimate
          </a>
        </div>
      </div>
    </div>

    <div class="container hero__headline">
      <h1>Water Damage? Remodeling? We've Got You Covered.</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center">What We Do</h2>
      <div class="grid grid--4">
        {services.map((s) => (
          <a href={`/${s.slug}`} class="card service-card">
            <div class="service-card__media">
              <img src={s.image} alt={s.title} class="service-card__img" loading="lazy" />
            </div>
            <div class="service-card__body">
              <h3>{s.title}</h3>
              <p class="muted">{s.short}</p>
              <span class="service-card__link">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Why Southwest Florida Homeowners Choose Coastal</h2>
      <ul class="why">
        <li><strong>We answer.</strong> Real people, 24/7, when your home can't wait.</li>
        <li><strong>The owner is on the job.</strong> Sean does the estimate and is on site while the work happens — not a salesman handing you off to a crew you've never met.</li>
        <li><strong>We handle the whole thing.</strong> Documentation, the adjuster's walkthrough, the scope, the finish repairs — from the insurance claim to the final coat of paint. <a href="/insurance-claim">Here's how it works →</a></li>
        <li><strong>One company, start to finish.</strong> Drying through finish repairs — one point of contact the whole way.</li>
        <li><strong>Local.</strong> Based in Punta Gorda, serving our own community.</li>
      </ul>
    </div>
  </section>

  <ReviewsStrip items={reviews} />

  <section class="section">
    <div class="container">
      <h2 class="center">Serving Southwest Florida</h2>
      <p class="center muted">
        {cities.map((c, i) => (
          <>
            <a href={`/service-areas/${c.slug}`}>{c.name}</a>{i < cities.length - 1 ? ' · ' : ''}
          </>
        ))}
        {' · '}
        <a href="/service-areas">See all areas</a>
      </p>
    </div>
  </section>

  <CTABand heading="Your home can't wait. Neither do we." />
</Base>

<style>
  /* MOBILE FIRST: photo, then a navy bar of stacked full-width buttons, then headline.
     Photo and bar are siblings so the bar never covers the photo at phone width. */
  .hero__media {
    background:
      url('/images/hero-house.avif') center / cover no-repeat,
      var(--blue-dark);
    aspect-ratio: 1912 / 998;
    min-height: 16rem;
  }

  .hero__barwrap {
    background: var(--blue-dark);
  }

  .hero__bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    padding-block: 1rem;
  }

  .hero__btn {
    font-size: 1.05rem;
    padding: 0.9rem 1.25rem;
  }

  /* Tagline sits in the bar — light text on navy (mobile) / on the photo (desktop) */
  .hero__sub {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #dbe8f0;
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
  }

  .hero__headline {
    text-align: center;
    padding-block: 2rem 0.5rem;
  }

  /* DESKTOP: buttons overlay the photo's bottom corners, tagline centered between.
     Breakpoint is 1200px — below that the three items can't sit on one line
     without the renovation button wrapping, so the stacked layout is used. */
  @media (min-width: 1200px) {
    .hero__stage {
      position: relative;
    }

    .hero__media {
      min-height: 60vh;
      aspect-ratio: auto;
    }

    /* Gradient only at the foot of the photo — the house itself stays uncovered */
    .hero__stage::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: 45%;
      background: linear-gradient(rgba(12, 36, 64, 0), rgba(12, 36, 64, 0.75));
      pointer-events: none;
    }

    .hero__barwrap {
      position: absolute;
      inset: auto 0 0 0;
      z-index: 1;
      background: none;
    }

    /* Buttons size to their content; the tagline takes the space between them */
    .hero__bar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.75rem;
      padding-block: 2rem;
      width: 100%;
    }

    .hero__bar .btn--emergency { justify-self: start; }
    .hero__bar .btn--primary { justify-self: end; }
    .hero__bar .btn {
      white-space: nowrap;
      /* Evens out the two buttons so the tagline sits near true center */
      min-width: 20rem;
      text-align: center;
    }

    .hero__sub {
      /* Over the photo, so it needs a shadow to stay legible */
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.75);
      color: #eef5f9;
    }

    .hero__btn {
      font-size: 1.1rem;
      padding: 1rem 1.6rem;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .hero__headline { padding-block: 2.5rem 1rem; }
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .service-card__media {
    position: relative;
    overflow: hidden;
  }

  .service-card__img {
    width: 100%;
    height: 10.5rem;
    object-fit: cover;
    display: block;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Scrim keeps the card bottom reading cleanly into the white body */
  .service-card__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(rgba(12, 36, 64, 0), rgba(12, 36, 64, 0.28));
    pointer-events: none;
  }

  .service-card:hover .service-card__img { transform: scale(1.06); }

  .service-card__body { padding: 1rem 1.1rem 1.25rem; }
  .service-card__body h3 { margin-bottom: 0.35rem; }
  .service-card__body p { font-size: 0.92rem; margin-bottom: 0.5rem; }
  .service-card__link { color: var(--blue); font-weight: 700; font-size: 0.92rem; }
  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: gap var(--ease);
  }

  .service-card:hover .service-card__link { gap: 0.55rem; }

  .why {
    max-width: 46rem;
    display: grid;
    gap: 0.9rem;
    padding-left: 0;
    list-style: none;
  }

  .why li {
    position: relative;
    padding-left: 1.9rem;
  }

  /* Small sky diamond — picks up the angular geometry in the logo mark */
  .why li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.62rem;
    height: 0.62rem;
    background: linear-gradient(145deg, var(--sky), var(--blue));
    transform: rotate(45deg);
    border-radius: 2px;
  }
</style>
