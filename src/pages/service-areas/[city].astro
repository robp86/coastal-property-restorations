---
// City pages generated from src/data/site.ts. RULE (spec §3): no copied content —
// each city ships only when its intro is ~300 genuinely local words. Until then
// the TODO placeholder makes the gap visible.
import Base from '../../layouts/Base.astro';
import TrustBar from '../../components/TrustBar.astro';
import ReviewsStrip from '../../components/ReviewsStrip.astro';
import CTABand from '../../components/CTABand.astro';
import { cities } from '../../data/site';
import { services } from '../../data/services';
import { reviews } from '../../data/reviews';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const cityReviews = reviews.filter((r) => r.city === city.name).slice(0, 3);
---

<Base
  title={`Restoration & Remodeling in ${city.name}, FL | Coastal Property Restorations`}
  description={`Roofing, storm damage restoration, and home remodeling in ${city.name}, Florida. Owner-operated, with 24/7 emergency response. Call 239-272-7064.`}
  breadcrumb={city.name}
>
  <TrustBar />

  <section class="section">
    <div class="container" style="max-width: 46rem;">
      <h1>Restoration &amp; Remodeling in {city.name}</h1>
      <p>{city.intro}</p>

      <h2>Services in {city.name}</h2>
      <ul>
        {services.map((s) => (
          <li>
            <a href={`/${s.slug}`}>{s.title}</a> — {s.short}
          </li>
        ))}
      </ul>

      {/* A real job from this city when we have one. Cities without a photo yet
          simply don't render this — never a stock stand-in (spec §3). */}
      {city.photo && (
        <figure class="city-photo">
          <img src={city.photo.src} alt={city.photo.alt} loading="lazy" />
          <figcaption>{city.photo.caption}</figcaption>
        </figure>
      )}

      {/* TODO: embedded map centered on this city */}
    </div>
  </section>

  {cityReviews.length > 0 && (
    <ReviewsStrip items={cityReviews} heading={`${city.name} Homeowners Say`} />
  )}

  <CTABand heading={`Need help in ${city.name}? We're close.`} />
</Base>

<style>
  .city-photo {
    margin: 2rem 0 0;
  }

  .city-photo img {
    width: 100%;
    border-radius: var(--radius);
  }

  .city-photo figcaption {
    font-size: 0.9rem;
    color: var(--muted);
    padding-top: 0.6rem;
    line-height: 1.5;
  }
</style>
