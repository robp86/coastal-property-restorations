---
// Form confirmation. Netlify redirects here after a successful submission, so
// this page IS the proof to the visitor that their request went through.
// noindex — it should never surface in search results.
import Base from '../layouts/Base.astro';
import TrustBar from '../components/TrustBar.astro';
import { site } from '../data/site';
---

<Base
  title="Request Received | Coastal Property Restorations"
  description="Thanks — we received your request and will be in touch shortly."
  noindex={true}
>
  <TrustBar />

  <section class="section">
    <div class="container thanks">
      <p class="thanks__check" aria-hidden="true">✓</p>
      <h1>Got it — thanks.</h1>
      <p class="thanks__lead">
        Your request came through and we'll be in touch shortly. If it's after
        hours, you'll hear from us first thing.
      </p>

      <div class="thanks__urgent">
        <p><strong>If this is an emergency — water coming in, a roof that's open — don't wait on us to call back.</strong></p>
        <a href={site.phoneHref} class="btn btn--emergency">📞 Call {site.phone} now</a>
      </div>

      <p class="muted">
        In the meantime, you can read about
        <a href="/insurance-claim">how the insurance claim process works</a> or see
        <a href="/reviews">what our customers say</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .thanks {
    max-width: 38rem;
    text-align: center;
    padding-block: 2rem;
  }

  .thanks__check {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue-dark);
    font-size: 1.9rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .thanks__lead {
    font-size: 1.15rem;
  }

  .thanks__urgent {
    background: var(--blue-light);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .thanks__urgent p {
    margin-bottom: 1rem;
  }
</style>
