---
import Base from '../layouts/Base.astro';
import TrustBar from '../components/TrustBar.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';
---

<Base
  title="Contact Us | Free Estimates | Coastal Property Restorations"
  description="Contact Coastal Property Restorations in Punta Gorda, FL for 24/7 emergency response or a free remodeling estimate. Call 239-272-7064."
  breadcrumb="Contact"
>
  <TrustBar />

  <section class="section">
    <div class="container contact">
      <div>
        <h1>Get In Touch</h1>
        <p style="max-width: 34rem;">
          Emergency? Skip the form — <a href={site.phoneHref}><strong>call {site.phone}</strong></a> and
          talk to a real person. For estimates and everything else, the form works great.
        </p>

        <h2 style="font-size: 1.15rem;">Coastal Property Restorations</h2>
        <p>
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}<br />
          <a href={site.phoneHref}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p><strong>{site.hours}</strong></p>

        {/* Keyless Google Maps embed, lazy-loaded so it never blocks the page. */}
        <iframe
          class="contact__map"
          title={`Map to ${site.name}, ${site.address.city}, ${site.address.state}`}
          src={`https://maps.google.com/maps?q=${encodeURIComponent(
            `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`
          )}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <LeadForm />
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
  }

  .contact__map {
    width: 100%;
    height: 16rem;
    border: 0;
    border-radius: var(--radius);
  }

  @media (min-width: 860px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
