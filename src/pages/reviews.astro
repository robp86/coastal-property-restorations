---
import Base from '../layouts/Base.astro';
import TrustBar from '../components/TrustBar.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
---

<Base
  title="Customer Reviews | Coastal Property Restorations"
  description="Real reviews from Southwest Florida homeowners — roofing, storm damage restoration, and remodeling projects by Coastal Property Restorations."
  breadcrumb="Reviews"
>
  <TrustBar />

  <section class="section">
    <div class="container">
      <h1>What Our Customers Say</h1>
      <p class="muted">
        {/* TODO: real rating + count from Google Business Profile */}
        ⭐ {site.googleRating} on Google ·
        <a href={site.googleReviewUrl}>Leave us a review</a>
      </p>

      <div class="grid grid--2" style="margin-top: 1.5rem;">
        {reviews.map((r) => (
          <blockquote class="card" style="margin: 0; padding: 1.5rem;">
            <p style="color: #e8a020; letter-spacing: 2px; margin-bottom: 0.5rem;" aria-label="5 out of 5 stars">★★★★★</p>
            <p>“{r.quote}”</p>
            <footer class="muted">— {r.name}, {r.city} · {r.source}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <CTABand heading="Join the list of happy homeowners." emergency={false} />
</Base>
