---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Page Not Found | Coastal Property Restorations"
  description="This page doesn't exist — but we're still here to help. Call Coastal Property Restorations at 239-272-7064."
>
  <section class="section">
    <div class="container center" style="padding-block: 4rem;">
      <h1>Page Not Found</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <p>
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href={site.phoneHref} class="btn btn--outline">📞 {site.phone}</a>
      </p>
    </div>
  </section>
</Base>
