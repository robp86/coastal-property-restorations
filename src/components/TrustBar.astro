---
// One row of real numbers only (spec §2.3). TODOs resolve from owner Q&A.
// Red appears here and nowhere else on the site: a single live-status dot on the
// 24/7 item (owner: "red only in small amounts").
interface Props {
  /* Homepage sets this false — its hero carries the 24/7 badge already */
  showLive?: boolean;
}

const { showLive = true } = Astro.props;

// Only claims we can actually stand behind.
// REMOVED (2026-08-27): "Licensed, Bonded & Insured" — the owner's contractor
// license is still in process, so the claim was not true. Do not restore any
// licensing language until the license number is confirmed and verified against
// the DBPR lookup; "bonded" and "insured" are separate claims needing separate
// confirmation. The Google rating is likewise absent until confirmed from GBP.
const items = [
  '🏠 Owner-Operated',
  '📍 Local — Punta Gorda Based',
  '🌴 Serving Charlotte & Lee County',
];
---

<div class="trustbar">
  <div class="container trustbar__inner">
    {showLive && (
      <span class="trustbar__live"><span class="trustbar__dot" aria-hidden="true"></span>24/7 Emergency Response</span>
    )}
    {items.map((item) => <span>{item}</span>)}
  </div>
</div>

<style>
  .trustbar {
    /* Logo sky blue with navy text — straight from the brand artwork */
    background: var(--sky);
    color: var(--blue-dark);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .trustbar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    justify-content: center;
    padding-block: 0.6rem;
  }

  .trustbar__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .trustbar__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 0 rgba(192, 57, 43, 0.6);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    70% { box-shadow: 0 0 0 0.5rem rgba(192, 57, 43, 0); }
    100% { box-shadow: 0 0 0 0 rgba(192, 57, 43, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .trustbar__dot { animation: none; }
  }
</style>
