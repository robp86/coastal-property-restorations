---
// Intro splash — the owner's blue logo screen, kept within spec §2 guardrails:
// homepage only (only index.astro imports this), ≤2s, tap/click skips, once per
// session, skipped entirely for reduced-motion users. Must never delay LCP content —
// the page renders underneath; this is just an overlay.
---

<div id="splash" class="splash" aria-hidden="true">
  {/* Full-res intro graphic (logo/CPR.jpg, 82KB). Background color matches the
      image's corner navy so the letterboxing is invisible at any viewport ratio. */}
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('splash');
    if (!el) return;
    var seen = false;
    try {
      seen = sessionStorage.getItem('cpr-splash') === '1';
    } catch (e) {}
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (seen || reduced) {
      el.remove();
      return;
    }

    try {
      sessionStorage.setItem('cpr-splash', '1');
    } catch (e) {}

    el.classList.add('splash--show');

    function dismiss() {
      el.classList.add('splash--hide');
      setTimeout(function () {
        el.remove();
      }, 400);
    }

    el.addEventListener('click', dismiss);
    setTimeout(dismiss, 1800);
  })();
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #09161f url('/images/splash.jpg') center / contain no-repeat;
    display: none;
    cursor: pointer;
    animation: splash-in 0.6s ease both;
  }

  .splash--show { display: block; }

  .splash--hide {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  @keyframes splash-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
